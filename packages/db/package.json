{
  "name": "@greenbuild/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate.js",
    "db:seed": "node dist/seed.js"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@greenbuild/challenge-spec": "workspace:*",
    "@greenbuild/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@greenbuild/config": "workspace:*",
    "@types/node": "^22.20.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
