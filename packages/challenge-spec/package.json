{
  "name": "@greenbuild/challenge-spec",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "challenges:validate": "node dist/cli.js ../../challenges",
    "challenges:schema": "node dist/write-schema.js"
  },
  "dependencies": {
    "@greenbuild/shared": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@greenbuild/config": "workspace:*",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
