{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenbuild.dev/schemas/queue/sandbox.create.v1.json",
  "title": "sandbox.create v1",
  "description": "API → engine: start a sandbox for an attempt and break it with the seed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "attempt_id", "image", "seed", "cpu_millis", "memory_bytes", "ttl_seconds", "network"],
  "properties": {
    "version": { "const": 1 },
    "attempt_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "image": { "type": "string", "minLength": 1, "maxLength": 512, "description": "Challenge image, by digest in production." },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Capped at 2^53-1: the API is TypeScript and larger JSON numbers lose precision there."
    },
    "cpu_millis": { "type": "integer", "minimum": 1, "maximum": 16000 },
    "memory_bytes": { "type": "integer", "minimum": 1048576 },
    "ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
    "network": { "enum": ["none"], "description": "Only none for now; allowlist comes with challenges that need it." },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["CHOWN", "DAC_OVERRIDE", "FOWNER", "KILL", "NET_BIND_SERVICE", "SETGID", "SETUID"] }
    }
  }
}
