{
  "name": "greenbuild",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run build && turbo run dev dev:compile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "play:up": "bash scripts/play-stack.sh up",
    "play:down": "bash scripts/play-stack.sh down",
    "challenges:validate": "turbo run build --filter=@greenbuild/challenge-spec... && pnpm --filter @greenbuild/challenge-spec challenges:validate"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.11.5"
  }
}
