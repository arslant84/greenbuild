{
  "name": "greenbuild",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run build && turbo run dev dev:compile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test \"scripts/*.test.mjs\"",
    "play:up": "node scripts/play.mjs up",
    "report:gate": "turbo run build --filter=@greenbuild/db... && node packages/db/dist/gate-report.js",
    "play:down": "node scripts/play.mjs down",
    "challenges:validate": "turbo run build --filter=@greenbuild/challenge-spec... && pnpm --filter @greenbuild/challenge-spec challenges:validate",
    "challenges:new": "turbo run build --filter=@greenbuild/challenge-spec... && pnpm --filter @greenbuild/challenge-spec challenges:new",
    "challenges:draft": "turbo run build --filter=@greenbuild/challenge-spec... && pnpm --filter @greenbuild/challenge-spec challenges:draft",
    "challenges:schema": "turbo run build --filter=@greenbuild/challenge-spec... && pnpm --filter @greenbuild/challenge-spec challenges:schema"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.11.5"
  }
}
