#!/bin/sh
# appctl start|stop|restart|status: runs the company app named in /etc/appctl.conf as its own user,
# with the limits from its environment file.
set -u

. /etc/appctl.conf
env_file="/etc/$APP/$APP.env"
log="/var/log/$APP/$APP.log"
pidfile="/run/$APP.pid"
# nginx stops within a moment when its configuration cannot be loaded.
readonly START_GRACE_SEC=1

# A process that exited but was never reaped shows state Z (PID 1 here is not an init): not running.
running() {
  [ -f "$pidfile" ] || return 1
  ps -o pid,stat | awk -v pid="$(cat "$pidfile")" '$1 == pid && $2 !~ /^Z/ { found = 1 } END { exit !found }'
}

start() {
  if running; then
    echo "$APP is already running"
    return 0
  fi
  . "$env_file"
  (ulimit -n "$LIMIT_NOFILE" && exec su -s /bin/sh "$APP_USER" -c "exec nginx -e stderr -c /etc/$APP/nginx.conf") >> "$log" 2>&1 &
  echo $! > "$pidfile"
  sleep "$START_GRACE_SEC"
  if ! running; then
    echo "$APP failed to start; see $log" >&2
    return 1
  fi
  echo "$APP started"
}

stop() {
  if running; then
    kill "$(cat "$pidfile")"
  fi
  rm -f "$pidfile"
  echo "$APP stopped"
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop && start ;;
  status) if running; then echo "$APP is running"; else echo "$APP is stopped"; exit 3; fi ;;
  *) echo "usage: appctl start|stop|restart|status" >&2; exit 2 ;;
esac
